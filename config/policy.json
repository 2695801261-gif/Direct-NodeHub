{
  "schema_version": 1,
  "schedule_hours": 6,
  "max_candidates_per_source": 300,
  "connect_timeout_seconds": 8,
  "read_timeout_seconds": 10,
  "minimum_successful_probes": 2,
  "minimum_exit_ip_agreement": 2,
  "max_cloud_latency_ms": 2500,
  "protocol_probe": {
    "max_candidates": 80,
    "mihomo_version": "v1.19.34"
  },
  "risk_policy": {
    "deny_known_abuse": true,
    "deny_tor_exit": true,
    "deny_open_proxy_abuse_reports": true,
    "quarantine_unknown_reputation": true,
    "require_exit_ip_verification": true
  },
  "publication": {
    "format": "mihomo",
    "include_cloud_latency_as_china_latency": false,
    "label_cloud_probe_location": true,
    "max_nodes": 100
  },
  "stability": {
    "rounds": 3,
    "required_successful_rounds": 3,
    "minimum_download_kbps": 64,
    "minimum_upload_kbps": 16,
    "fast_pool_minimum_download_kbps": 256,
    "fast_pool_minimum_upload_kbps": 64,
    "max_candidates": 60
  }
}
